# Qdrant local (docker compose up -d)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=chunks

# Embeddings : le nom du modèle suffit. La dimension Qdrant est lue chez FastEmbed.
# Repli si le modèle n'est pas dans FastEmbed : DEFAULT_EMBED_FALLBACK_MODEL dans config.py
EMBED_MODEL=BAAI/bge-m3
# Optionnel — ignoré si FastEmbed publie la dim du modèle. Dernier recours : DEFAULT_EMBED_DIM.
# EMBED_DIM=1024

# Ollama — LangExtract
OLLAMA_BASE_URL=http://localhost:11434
LANGEXTRACT_MODEL=llama3.1:8b
LANGEXTRACT_TIMEOUT_SECONDS=300
# Prompt + few-shots (chemins relatifs à la racine du dépôt). Pour un autre projet :
# pointe vers d'autres fichiers, sans toucher au code.
LANGEXTRACT_PROMPT_FILE=config/langextract/prompt.txt
LANGEXTRACT_FEW_SHOTS_FILE=config/langextract/few_shots.json
# Alias accepté : LANGEXTRACT_FEW_SHOTS_EXAMPLE=...

# LiteParse / OCR (plugin, pas une étape amont)
OCR_LANGUAGE=fra
OCR_SERVER_URL=
OCR_HEAVY_RATIO=0.5

# Chunking (caractères ≈ 400–800 tokens FR)
CHUNK_SIZE_CHARS=2400
CHUNK_OVERLAP_CHARS=300

# Artefacts locaux
DATA_DIR=data

# Chatbot (rag-chat) — fichiers sous config/chatbot/ (comme LangExtract).
# Lancer llama-server : llama-server --jinja -fa -m /chemin/vers/modele.gguf --port 8080
CHAT_PROMPT_FILE=config/chatbot/prompt.txt
CHAT_SETTINGS_FILE=config/chatbot/settings.json
# Surcharges optionnelles (sinon les valeurs viennent du JSON) :
# LLAMA_SERVER_BASE_URL=http://localhost:8080/v1
# LLAMA_SERVER_MODEL=local
# LLAMA_SERVER_API_KEY=sk-no-key-required
# CHAT_TEMPERATURE=0.2
# CHAT_RAG_LIMIT=5
# CHAT_API_HOST=127.0.0.1
# CHAT_API_PORT=8000
