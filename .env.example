# Qdrant local (docker compose up -d)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=chunks

# --- Embeddings : le nom du modèle suffit. La dimension Qdrant est lue chez FastEmbed.
# Repli si le modèle n'est pas dans FastEmbed : DEFAULT_EMBED_FALLBACK_MODEL dans config.py
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
# Optionnel — ignoré si FastEmbed publie la dim du modèle. Dernier recours : DEFAULT_EMBED_DIM.
# EMBED_DIM=1024

# --- LLM : chat + LangExtract (le RAG embeddings reste FastEmbed local) ---
# Un seul switch : local | ollama | openai | gemini
# Chat et extract suivent LLM_PROVIDER, sauf override CHAT_PROVIDER / LANGEXTRACT_PROVIDER.
LLM_PROVIDER=gemini
# CHAT_PROVIDER=gemini
# LANGEXTRACT_PROVIDER=openai

# Gemini (LLM_PROVIDER=gemini) — clé AI Studio / Google AI
# Chat utilise le SDK natif (thought_signature / tools Gemini 3).
# LangExtract utilise aussi l’API Gemini native.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_BASE_URL n’est plus utilisé par le chat (SDK natif).

# OpenAI ou n'importe quel endpoint /v1 (Groq, Together, llama-server cloud…)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama local (LLM_PROVIDER=ollama) — chat via /v1 + LangExtract
OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_CHAT_MODEL=llama3.1:8b
LANGEXTRACT_MODEL=llama3.1:8b
LANGEXTRACT_TIMEOUT_SECONDS=300
# Profils LangExtract (prompt.base + addendum + few-shots par type de document).
# Le nom du PDF choisit le profil (motifs dans profiles.json) ; sinon default.
LANGEXTRACT_PROFILES_FILE=config/langextract/profiles.json
# Repli si profiles.json est absent :
# LANGEXTRACT_PROMPT_FILE=config/langextract/prompt.base.txt
# LANGEXTRACT_FEW_SHOTS_FILE=config/langextract/profiles/default/few_shots.json

# LiteParse / OCR (plugin, pas une étape amont)
OCR_LANGUAGE=fra
OCR_SERVER_URL=
OCR_HEAVY_RATIO=0.5

# Chunking (caractères ≈ 400–800 tokens FR)
CHUNK_SIZE_CHARS=2400
CHUNK_OVERLAP_CHARS=300

# Artefacts locaux
DATA_DIR=data
# Catalog SQLite (sites / documents / events) : ${DATA_DIR}/catalog.sqlite
# Géocodage Nominatim à l'ingest (lat/lon pour la carte). 0 = skip.
GEOCODE_ENABLED=1
# GEOCODE_USER_AGENT=rag-ingestion/0.1 (enviro-rag)

# Drop folder (worker `rag-ingest watch` / service Compose `worker`)
INCOMING_DIR=incoming
ARCHIVE_DIR=data/archive
FAILED_DIR=data/failed
INGEST_POLL_SECONDS=10
INGEST_SKIP_EXISTING=1
# 1 = pas de LangExtract (si Ollama n'est pas disponible)
INGEST_SKIP_EXTRACT=0
# Ré-ingest d'un SHA déjà au catalog : rag-ingest watch --force

# Chatbot — fichiers + llama-server si LLM_PROVIDER=local
CHAT_PROMPT_FILE=config/chatbot/prompt.txt
CHAT_SETTINGS_FILE=config/chatbot/settings.json
# llama-server (LLM_PROVIDER=local). Docker réécrit localhost → host.docker.internal.
# LLAMA_SERVER_BASE_URL=http://localhost:8080/v1
# LLAMA_SERVER_MODEL=local
# LLAMA_SERVER_API_KEY=sk-no-key-required
# CHAT_TEMPERATURE=0.0
# CHAT_TOP_P=0.9
# CHAT_RAG_LIMIT=8
# CHAT_RAG_PREFETCH=20
# CHAT_RAG_SCORE_THRESHOLD=0.0
# CHAT_RAG_HIT_MAX_CHARS=1800
# CHAT_RAG_TABLE_MAX_CHARS=3200
# CHAT_RAG_INCLUDE_CATALOG=1
# CHAT_RAG_HYBRID_TEXT=1
# CHAT_CHECKPOINT_DB=data/chat_checkpoints.sqlite
# CHAT_API_HOST=127.0.0.1
# CHAT_API_PORT=8000

# UI (Vite build / Compose service `ui`)
# Régénérer la clé Maps si une ancienne a été commitée dans enviro-rag-mtl.
# VITE_GOOGLE_MAPS_API_KEY=
# Map ID Cloud (Advanced Markers). Défaut : DEMO_MAP_ID (dev).
# VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
# UI_PORT=3000
